<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VelaryMobile.Pages.Admin.AdminPedidosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pedidos"
    BackgroundColor="#F5F5F5">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Gerenciar Pedidos"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#111827" />

            <Label
                Text="Pedidos realizados pelos clientes"
                FontSize="14"
                TextColor="#777777"
                Margin="0,0,0,10" />

            <CollectionView
                x:Name="PedidosCollectionView"
                SelectionMode="None">

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Padding="30"
                        Spacing="10"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Label
                            Text="Nenhum pedido encontrado."
                            FontSize="18"
                            TextColor="#777777"
                            HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,12"
                            Padding="16"
                            BackgroundColor="White"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 15">

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="{Binding Id, StringFormat='Pedido #{0}'}"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="#111827" />

                                <Label
                                    Text="{Binding UsuarioId, StringFormat='Cliente ID: {0}'}"
                                    FontSize="14"
                                    TextColor="#777777" />

                                <Label
                                    Text="{Binding ValorTotal, StringFormat='Total: R$ {0:F2}'}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    TextColor="#D4AF37" />

                                <Label
                                    Text="{Binding Status, StringFormat='Status: {0}'}"
                                    FontSize="14"
                                    TextColor="#2E7D32" />

                                <Label
                                    Text="{Binding DataPedido, StringFormat='Data: {0:dd/MM/yyyy HH:mm}'}"
                                    FontSize="13"
                                    TextColor="#777777" />

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>

                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>