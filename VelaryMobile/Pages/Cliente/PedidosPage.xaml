<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VelaryMobile.Pages.Cliente.PedidosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Meus Pedidos"
    BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout
            Grid.Row="0"
            Padding="20,25,20,15">

            <Label
                Text="VALERY"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#D4AF37" />

            <Label
                Text="Meus Pedidos"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#111827"
                Margin="0,5,0,0" />

        </VerticalStackLayout>

        <CollectionView
            x:Name="PedidosCollectionView"
            Grid.Row="1"
            Margin="20,0">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="20,60"
                    HorizontalOptions="Center">

                    <Label
                        Text="Você ainda não possui pedidos."
                        FontSize="16"
                        TextColor="#777777"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="0,0,0,15"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#DDDDDD"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout Spacing="8">

                            <Label
                                Text="{Binding Id, StringFormat='Pedido #{0}'}"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#111827" />

                            <Label
                                Text="{Binding ValorTotal, StringFormat='Valor: R$ {0:F2}'}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#D4AF37" />

                            <Label
                                Text="{Binding Status, StringFormat='Status: {0}'}"
                                FontSize="14"
                                TextColor="#555555" />

                            <Label
                                Text="{Binding DataPedido, StringFormat='Data: {0:dd/MM/yyyy HH:mm}'}"
                                FontSize="13"
                                TextColor="#777777" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>